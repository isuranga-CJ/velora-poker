{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "velora-poker-beta",
  "main": "index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "POKER", "class_name": "PokerWorld" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PokerWorld"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://velora-poker-cj.dewybow7.chatgpt.site"
  }
}
